# Usage after SDK installation:
#   1. Copy sw/build/sdk_env.sh.template to sw/build/sdk_env.sh and update paths.
#   2. Source sw/build/sdk_env.sh in your shell.
#   3. Build from this directory with the same SOC/BOARD/CORE variables used by the SDK.

PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SDK_ENV ?= $(PROJECT_ROOT)/../build/sdk_env.sh

ifndef NUCLEI_SDK_ROOT
$(error NUCLEI_SDK_ROOT is not set. Source sw/build/sdk_env.sh first)
endif

include $(PROJECT_ROOT)/config/project.mk

TARGET ?= $(APP_NAME)
SRCDIRS += $(PROJECT_ROOT)/application
INCDIRS += $(PROJECT_ROOT)/application $(PROJECT_ROOT)/../inc

include $(NUCLEI_SDK_ROOT)/Build/Makefile.base
